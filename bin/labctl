wan-create) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; a="$1"; b="$2"; br="${3:-br-wan}"; iface_exists "$a"; iface_exists "$b"; sudo_if_needed ip link add "$br" type bridge; sudo_if_needed ip link set "$a" master "$br"; sudo_if_needed ip link set "$b" master "$br"; sudo_if_needed ip link set "$a" up; sudo_if_needed ip link set "$b" up; sudo_if_needed ip link set "$br" up; echo "$a <-> $br <-> $b" ;;
