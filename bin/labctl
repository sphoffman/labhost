iperf-parallel) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; exec iperf3 -c "$1" -P "$2" -t "${3:-10}" ;;
iperf-bind) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; exec iperf3 -B "$1" -c "$2" -t "${3:-10}" ;;
iperf-mcast-server) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; exec iperf -s -u -B "$1" -p "${2:-5001}" ;;
