netem-profile)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; i="$1"; p="$2"
    case "$p" in
      clean) sudo_if_needed tc qdisc del dev "$i" root 2>/dev/null || true ;;
      wan) sudo_if_needed tc qdisc replace dev "$i" root netem delay 20ms 2ms ;;
      bad-wan) sudo_if_needed tc qdisc replace dev "$i" root netem delay 75ms 15ms loss 1% ;;
      satellite) sudo_if_needed tc qdisc replace dev "$i" root netem delay 300ms 20ms loss 0.2% ;;
      lossy) sudo_if_needed tc qdisc replace dev "$i" root netem delay 10ms loss 5% ;;
      mobile) sudo_if_needed tc qdisc replace dev "$i" root netem delay 40ms 20ms loss 0.5% reorder 1% ;;
      *) die "Unknown profile $p" ;;
    esac
    ;;
