      capture-lacp) sudo_if_needed tcpdump -enni "$1" 'ether proto 0x8809' ;;
      capture-igmp) sudo_if_needed tcpdump -nni "$1" igmp ;;
      capture-pim) sudo_if_needed tcpdump -nni "$1" 'ip proto 103' ;;
      capture-arp) sudo_if_needed tcpdump -enni "$1" arp ;;
      capture-nd) sudo_if_needed tcpdump -nni "$1" 'icmp6 and (ip6[40] >= 133 and ip6[40] <= 136)' ;;
    esac
    ;;
netem) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; i="$1"; shift; iface_exists "$i"; sudo_if_needed tc qdisc replace dev "$i" root netem "$@" ;;
