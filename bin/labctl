iperf-test) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; s="$1"; echo '=== TCP forward ==='; iperf3 -c "$s" -t 5; echo '=== TCP reverse ==='; iperf3 -c "$s" -R -t 5; echo '=== TCP 4 streams ==='; iperf3 -c "$s" -P 4 -t 5; echo '=== UDP 100M ==='; iperf3 -c "$s" -u -b 100M -t 5 ;;
mcast-join)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    require_args "$CMD" 2 "$@"
    i="$1"; g="$2"; src="${3:-}"
    if [[ -n "$src" ]]; then
        exec mcjoin -i "$i" "${src}+${g}"
    else
        exec mcjoin -i "$i" "$g"
    fi
    ;;
mcast-send) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; exec mcjoin -i "$1" -s -t "${3:-32}" "$2" ;;
http-server) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; p="${1:-8080}"; d="${2:-/tmp}"; cd "$d"; exec python3 -m http.server "$p" --bind 0.0.0.0 ;;
https-server)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; p="${1:-8443}"; d="${2:-/tmp}"; cert="$STATE/labhost.crt"; key="$STATE/labhost.key"
    if [[ ! -f "$cert" ]]; then openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj '/CN=labhost' -keyout "$key" -out "$cert" >/dev/null 2>&1; fi
    cd "$d"
    exec python3 - "$p" "$cert" "$key" <<'PY'
import http.server,ssl,sys
p=int(sys.argv[1]); c=sys.argv[2]; k=sys.argv[3]
s=http.server.ThreadingHTTPServer(('0.0.0.0',p),http.server.SimpleHTTPRequestHandler)
ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.load_cert_chain(c,k); s.socket=ctx.wrap_socket(s.socket,server_side=True); s.serve_forever()
PY
    ;;
tcp-listen) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; exec socat -v TCP-LISTEN:"$1",fork,reuseaddr STDOUT ;;
udp-listen) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; exec socat -v UDP-RECVFROM:"$1",fork STDOUT ;;
dhcp-pool-create)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    require_args "$CMD" 5 "$@"
    iface="$1"; start="$2"; end="$3"; mask="$4"; gw="$5"; dns="${6:-$5}"; lease="${7:-1h}"
    iface_exists "$iface"
    [[ "$iface" != "$MGMT_IF" && "$iface" != "$MGMT_VRF" ]] || die "Refusing to run a DHCP pool on the management interface/VRF."
    ensure_intent_dir
    f="$(dhcp_pool_path "$iface")"
    cat >"$f" <<EOF
iface=$(printf '%q' "$iface")
start=$(printf '%q' "$start")
end=$(printf '%q' "$end")
mask=$(printf '%q' "$mask")
gw=$(printf '%q' "$gw")
dns=$(printf '%q' "$dns")
lease=$(printf '%q' "$lease")
EOF
    echo "DHCP pool saved for $iface: $start-$end gateway $gw DNS $dns lease $lease"
    if dhcp_server_running; then dhcp_server_start_impl; fi
    ;;
dhcp-pool-delete)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"
    rm -f "$(dhcp_pool_path "$1")"
    echo "DHCP pool removed for $1"
    if dhcp_server_running; then
        if compgen -G "$DHCP_SERVER_INTENT_DIR/*.conf" >/dev/null; then dhcp_server_start_impl; else dhcp_server_stop_impl; fi
    fi
    ;;
dhcp-pool-list)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    printf '%-16s %-15s %-15s %-15s %-15s %-15s %s\n' INTERFACE START END NETMASK GATEWAY DNS LEASE
    for f in "$DHCP_SERVER_INTENT_DIR"/*.conf; do
        [[ -r "$f" ]] || continue
        source "$f"
        printf '%-16s %-15s %-15s %-15s %-15s %-15s %s\n' "$iface" "$start" "$end" "$mask" "$gw" "$dns" "$lease"
    done
    ;;
dhcp-server-start)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    ensure_intent_dir
    touch "$DHCP_SERVER_INTENT_DIR/.enabled"
    if dhcp_server_running; then
        echo "DHCP server is already running (PID $(cat "$DHCP_SERVER_PID"))."
    else
        dhcp_server_start_impl
    fi
    ;;
dhcp-server-stop)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    dhcp_server_stop_impl; rm -f "$DHCP_SERVER_INTENT_DIR/.enabled"; echo 'DHCP server stopped.'
    ;;
dhcp-server-status)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    dhcp-pool-list
    echo
    if dhcp_server_running; then echo "DHCP server: RUNNING (PID $(cat "$DHCP_SERVER_PID"))"; else echo 'DHCP server: STOPPED'; fi
    if [[ -s "$DHCP_SERVER_LEASES" ]]; then echo; echo '=== Leases ==='; cat "$DHCP_SERVER_LEASES"; fi
    ;;
dnsmasq-start)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    i="${1:-}"
    args=(--no-daemon --log-queries --log-dhcp)
    if [[ -n "$i" ]]; then
        args+=(--interface="$i" --bind-interfaces)
    fi
    sudo_if_needed dnsmasq "${args[@]}"
    ;;
dnsmasq-stop) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; sudo_if_needed pkill dnsmasq || true ;;
tftp-server) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; d="${1:-/tmp/tftp}"; sudo_if_needed mkdir -p "$d"; sudo_if_needed chmod 777 "$d"; exec sudo /usr/bin/in.tftpd --foreground --listen --address 0.0.0.0:69 --secure "$d" ;;
lldp-start) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; sudo_if_needed lldpd; echo 'lldpd started' ;;
lldp-show) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; lldpcli show neighbors details ;;
