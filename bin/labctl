radius-test) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 4 "$@"; printf 'User-Name = "%s"\nUser-Password = "%s"\n' "$2" "$3" | radclient -x "$1" auth "$4" ;;
snmp-walk) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; snmpwalk -v2c -c "${2:-public}" "$1" "${3:-1.3.6.1.2.1}" ;;
snmp-get) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; snmpget -v2c -c "${3:-public}" "$1" "$2" ;;
arp-watch) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; sudo_if_needed tcpdump -enni "$1" arp ;;
nd-watch) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"; sudo_if_needed tcpdump -nni "$1" 'icmp6 and (ip6[40] >= 133 and ip6[40] <= 136)' ;;
gratuitous-arp) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; sudo_if_needed arping -A -I "$1" -c 3 "$2" ;;
arp-clear)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    if [[ -n "${1:-}" ]]; then
        sudo_if_needed ip neigh flush dev "$1"
    else
        sudo_if_needed ip neigh flush all
    fi
    ;;
pc-phone-create)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"
    parent="$1"; shift; dhcp=1
    [[ "${1:-}" == "--no-dhcp" ]] && { dhcp=0; shift; }
    [[ $# -eq 0 ]] || die "Unknown option: $1"
    iface_exists "$parent"; [[ "$parent" != "$MGMT_IF" && "$parent" != "$MGMT_VRF" ]] || die "Management interface cannot be a PC/phone port."
    sudo_if_needed mkdir -p "$PC_PHONE_RUN_DIR"; ensure_intent_dir
    # Creation is intentionally idempotent. A repeated create leaves live
    # DHCP/LLDP state untouched. Use pc-phone-reprovision for a rebuild.
    if [[ -r "$PC_PHONE_INTENT_DIR/${parent}.conf" ]]; then
        echo "PC/phone already exists on $parent; no changes made."
        exit 0
    fi
    read -r pc_mac phone_mac < <(python3 - "$parent" "$(hostname -s)" <<'PY'
import hashlib,sys
p,h=sys.argv[1:]
def m(role):
 d=hashlib.sha256(f"labhost:{h}:pc-phone:{p}:{role}".encode()).digest(); return "02:"+":".join(f"{x:02x}" for x in d[:5])
print(m('pc'),m('phone'))
PY
)
    # A PC/phone port owns the endpoint identity on the wire.  Suppress the
    # normal host-wide lldpd advertisement and remove L3 identity from the
    # parent so the container's original ethX MAC does not bleed into the
    # access VLAN.  The PC and phone child identities carry endpoint traffic.
    sudo_if_needed lldpcli configure ports "$parent" lldp status disabled >/dev/null 2>&1 || true
    sudo_if_needed ip -4 addr flush dev "$parent" scope global 2>/dev/null || true
    sudo_if_needed ip -6 addr flush dev "$parent" scope global 2>/dev/null || true

    # The physical parent represents the phone's switch-facing Ethernet port.
    # Save Containerlab's original MAC so delete can restore it, then make the
    # parent itself use the deterministic phone MAC.  Any kernel-originated
    # untagged traffic (IPv6 RS/ND, etc.) is therefore learned as PHONE_MAC
    # rather than leaking a fourth container-interface identity to the switch.
    origmac_file="$PC_PHONE_RUN_DIR/${parent}.origmac"
    if [[ ! -r "$origmac_file" ]]; then
        cat "/sys/class/net/$parent/address" | sudo_if_needed tee "$origmac_file" >/dev/null
    fi
    sudo_if_needed ip link set dev "$parent" down
    sudo_if_needed ip link set dev "$parent" address "$phone_mac"
    sudo_if_needed ip link set dev "$parent" up

    pc="pp-${parent}-pc"; pc="${pc:0:15}"
    ip link show "$pc" >/dev/null 2>&1 || sudo_if_needed ip link add link "$parent" name "$pc" address "$pc_mac" type macvlan mode bridge
    sudo_if_needed ip link set "$pc" up
    if (( dhcp )); then
        sudo_if_needed dhcpcd -4 -q -b -C resolv.conf "$pc" >/dev/null 2>&1 || true
    fi
    pidfile="$PC_PHONE_RUN_DIR/${parent}.pid"; statefile="$PC_PHONE_RUN_DIR/${parent}.state"
    if [[ -r "$pidfile" ]]; then sudo_if_needed kill "$(cat "$pidfile")" 2>/dev/null || true; fi
    args=(/usr/local/lib/labhost/pc_phone_lldp.py --parent "$parent" --mac "$phone_mac" --name "$(hostname -s)-phone-${parent}" --state "$statefile")
    (( dhcp )) && args+=(--dhcp)
    sudo_if_needed bash -c 'log="$1"; pidfile="$2"; shift 2; nohup "$@" >"$log" 2>&1 & echo $! >"$pidfile"' _ "$PC_PHONE_RUN_DIR/${parent}.log" "$pidfile" "${args[@]}"
    # Real phones initially speak untagged before/while learning their voice
    # policy.  Emit a few ARP probes from the phone MAC so the switch can
    # legitimately learn PHONE_MAC in the native VLAN.  Persistent learning
    # on the switch may then retain it after voice traffic moves tagged.
    sudo_if_needed python3 - "$parent" "$phone_mac" <<'PYARP' >/dev/null 2>&1 || true
import socket,sys,time
iface,mac=sys.argv[1:]
src=bytes.fromhex(mac.replace(':',''))
dst=b'\xff'*6
# ARP probe: Ethernet src=phone MAC, sender IP 0.0.0.0, target IP 0.0.0.0.
arp=b'\x00\x01\x08\x00\x06\x04\x00\x01'+src+b'\x00'*4+b'\x00'*6+b'\x00'*4
frame=dst+src+b'\x08\x06'+arp
s=socket.socket(socket.AF_PACKET,socket.SOCK_RAW); s.bind((iface,0))
for _ in range(3): s.send(frame); time.sleep(.15)
PYARP
    if (( dhcp )); then printf 'pc-phone-create %q\n' "$parent" >"$PC_PHONE_INTENT_DIR/${parent}.conf"; else printf 'pc-phone-create %q --no-dhcp\n' "$parent" >"$PC_PHONE_INTENT_DIR/${parent}.conf"; fi
    echo "PC/phone created on $parent"; echo "  PC:    $pc  $pc_mac  native/untagged"; echo "  Phone: $phone_mac  LLDP-MED waiting for Voice Network Policy"
    ;;
pc-phone-status|pc-phones-status)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; filter="${1:-}"
    printf '%-7s %-13s %-18s %-15s %-18s %-7s %-15s %-4s %-4s %-4s\n' \
        PARENT PC_IF PC_MAC PC_IP PHONE_MAC VOICE PHONE_IP TAG PRI DSCP
    found=0
    for f in "$PC_PHONE_INTENT_DIR"/*.conf; do
        [[ -r "$f" ]] || continue
        parent="${f##*/}"; parent="${parent%.conf}"
        [[ -z "$filter" || "$filter" == "$parent" ]] || continue
        found=1
        read -r pc_mac phone_mac < <(python3 - "$parent" "$(hostname -s)" <<'PY'
import hashlib,sys
p,h=sys.argv[1:]
def m(r):
 d=hashlib.sha256(f"labhost:{h}:pc-phone:{p}:{r}".encode()).digest(); return "02:"+":".join(f"{x:02x}" for x in d[:5])
print(m('pc'),m('phone'))
PY
)
        pc="pp-${parent}-pc"; pc="${pc:0:15}"
        pc_ip='-'; phone_ip='-'; voice='WAIT'; tag='-'; pri='-'; dscp_out='-'; voice_iface=''
        if ip link show "$pc" >/dev/null 2>&1; then
            pc_ip="$(ip -4 -o addr show dev "$pc" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
            [[ -n "$pc_ip" ]] || pc_ip='-'
        fi
        st="$PC_PHONE_RUN_DIR/${parent}.state"
        if [[ -r "$st" ]]; then
            unset vlan tagged priority dscp voice_iface
            source "$st"
            voice="${vlan:-?}"
            case "${tagged:-}" in 1) tag='yes' ;; 0) tag='no' ;; *) tag='?' ;; esac
            pri="${priority:-?}"; dscp_out="${dscp:-?}"
            if [[ -n "${voice_iface:-}" ]] && ip link show "$voice_iface" >/dev/null 2>&1; then
                phone_ip="$(ip -4 -o addr show dev "$voice_iface" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
                [[ -n "$phone_ip" ]] || phone_ip='-'
            fi
        fi
        printf '%-7s %-13s %-18s %-15s %-18s %-7s %-15s %-4s %-4s %-4s\n' \
            "$parent" "$pc" "$pc_mac" "$pc_ip" "$phone_mac" "$voice" "$phone_ip" "$tag" "$pri" "$dscp_out"
    done
    if [[ -n "$filter" && $found -eq 0 ]]; then
        die "No PC/phone intent for $filter"
    fi
    ;;
pc-phones-create)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    [[ $# -ge 1 ]] || { help_command "$CMD"; exit 2; }
    dhcp_opt=(); all=0; parents=()
    for arg in "$@"; do
        case "$arg" in
            --all) all=1 ;;
            --no-dhcp) dhcp_opt=(--no-dhcp) ;;
            --*) die "Unknown option: $arg" ;;
            *) parents+=("$arg") ;;
        esac
    done
    if (( all )); then
        (( ${#parents[@]} == 0 )) || die "Do not combine --all with explicit parent interfaces."
        mapfile -t parents < <(
            for path in /sys/class/net/eth[0-9]*; do
                [[ -e "$path" ]] || continue
                i="${path##*/}"
                [[ "$i" =~ ^eth[0-9]+$ ]] || continue
                [[ "$i" != "$MGMT_IF" ]] || continue
                printf '%s\n' "$i"
            done | sort -V
        )
    fi
    (( ${#parents[@]} > 0 )) || die "No dataplane interfaces found."
    rc=0
    for parent in "${parents[@]}"; do
        echo "=== $parent ==="
        if ! /usr/local/bin/pc-phone-create "$parent" "${dhcp_opt[@]}"; then rc=1; fi
    done
    exit "$rc"
    ;;
pc-phone-reprovision)
    require_args "$CMD" 1 "$@"; parent="$1"; f="$PC_PHONE_INTENT_DIR/${parent}.conf"; [[ -r "$f" ]] || die "No PC/phone intent for $parent"
    # Preserve the high-level create intent before delete removes its file.
    intent="$(cat "$f")"
    /usr/local/bin/pc-phone-delete "$parent"
    bash -c "$intent"
    ;;
pc-phone-delete)
    require_args "$CMD" 1 "$@"; parent="$1"; pidfile="$PC_PHONE_RUN_DIR/${parent}.pid"; st="$PC_PHONE_RUN_DIR/${parent}.state"
    [[ -r "$pidfile" ]] && sudo_if_needed kill "$(cat "$pidfile")" 2>/dev/null || true
    if [[ -r "$st" ]]; then voice_iface=""; source "$st"; [[ -n "${voice_iface:-}" && "$voice_iface" != "$parent" ]] && sudo_if_needed ip link del "$voice_iface" 2>/dev/null || true; fi
    pc="pp-${parent}-pc"; pc="${pc:0:15}"; sudo_if_needed ip link del "$pc" 2>/dev/null || true
    # Restore Containerlab's original parent MAC before returning LLDP ownership.
    origmac_file="$PC_PHONE_RUN_DIR/${parent}.origmac"
    if [[ -r "$origmac_file" ]]; then
        original_mac="$(cat "$origmac_file")"
        sudo_if_needed ip link set dev "$parent" down
        sudo_if_needed ip link set dev "$parent" address "$original_mac"
        sudo_if_needed ip link set dev "$parent" up
    fi
    # Return LLDP ownership to normal labhost behavior when the abstraction is removed.
    sudo_if_needed lldpcli configure ports "$parent" lldp status rx-and-tx >/dev/null 2>&1 || true
    rm -f "$PC_PHONE_INTENT_DIR/${parent}.conf" "$pidfile" "$st" "$PC_PHONE_RUN_DIR/${parent}.log" "$origmac_file" 2>/dev/null || true
    echo "PC/phone removed from $parent"
    ;;
clients-create)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 3 "$@"
    parent="$1"; count="$2"; cidr="$3"; start="${4:-10}"; iface_exists "$parent"
    [[ "$count" =~ ^[1-9][0-9]*$ ]] || die "count must be a positive integer"

    last_client="$(
        ip -o link show type macvlan 2>/dev/null |
        awk -F': ' '{print $2}' | cut -d@ -f1 |
        sed -nE 's/^cl([0-9]+)$/\1/p' | sort -n | tail -1
    )"
    if [[ -n "$last_client" ]]; then
        client_start=$((10#$last_client + 1))
    else
        client_start=1
    fi

    tmpfile="$(mktemp)"
    trap 'rm -f "$tmpfile"' RETURN
    python3 - "$count" "$cidr" "$start" "$client_start" "$(hostname -s)" >"$tmpfile" <<'PY'
import hashlib, ipaddress, sys
count=int(sys.argv[1]); cidr=sys.argv[2]; start_arg=sys.argv[3]
client_start=int(sys.argv[4]); host=sys.argv[5]
net=ipaddress.ip_network(cidr, strict=False)
try:
    first=net.network_address+int(start_arg)
except ValueError:
    first=ipaddress.ip_address(start_arg)
    if first not in net: raise SystemExit("starting IP is outside subnet")
for offset in range(count):
    ip=first+offset
    if ip not in net or ip in (net.network_address, net.broadcast_address):
        raise SystemExit("address range exceeds subnet")
    client_num=client_start+offset
    name=f"cl{client_num:03d}"
    digest=hashlib.sha256(f"labhost:{host}:client:{client_num}".encode()).digest()
    mac="02:"+":".join(f"{b:02x}" for b in digest[:5])
    print(name,mac,f"{ip}/{net.prefixlen}")
PY

    created=0
    first_name=""
    last_name=""
    while read -r name mac addr; do
        [[ -n "$first_name" ]] || first_name="$name"
        last_name="$name"
        echo "Creating $name  $addr  $mac  on $parent"
        sudo_if_needed ip link add link "$parent" name "$name" address "$mac" type macvlan mode bridge
        sudo_if_needed ip addr add "$addr" dev "$name"
        sudo_if_needed ip link set "$name" up
        if [[ "$(sysctl -n "net.ipv4.conf.${name}.arp_ignore" 2>/dev/null || true)" != "1" ]]; then
            sudo_if_needed sysctl -w "net.ipv4.conf.${name}.arp_ignore=1" >/dev/null
        fi
        if [[ "$(sysctl -n "net.ipv4.conf.${name}.arp_announce" 2>/dev/null || true)" != "2" ]]; then
            sudo_if_needed sysctl -w "net.ipv4.conf.${name}.arp_announce=2" >/dev/null
        fi
        created=$((created + 1))
    done <"$tmpfile"
    rm -f "$tmpfile"
    trap - RETURN

    if (( created > 0 )); then
        ensure_intent_dir
        printf 'clients-create %q %q %q %q\n' "$parent" "$count" "$cidr" "$start" >"$CLIENT_INTENT_DIR/${first_name}-${last_name}.conf"
    fi
    echo
    echo "$created clients created."
    [[ -n "$last_name" ]] && echo "Client interfaces now range through $last_name."
    ;;
clients-list) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; ip -d -o link show type macvlan | strip_peer || true; ip -br addr | grep '^cl[0-9]' | strip_peer || true ;;
clients-status)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    printf '%-8s %-14s %-18s %-18s %-10s %-12s\n' CLIENT PARENT MAC IPv4 ARP_IGNORE ARP_ANNOUNCE
    while read -r iface; do
        [[ -n "$iface" ]] || continue
        parent="$(ip -o link show "$iface" | awk -F'@' '{print $2}' | awk -F': ' '{print $1}' | awk '{print $1}')"
        mac="$(cat "/sys/class/net/$iface/address" 2>/dev/null || echo '?')"
        addr="$(ip -4 -o addr show dev "$iface" scope global | awk '{print $4}' | head -1)"
        ai="$(sysctl -n "net.ipv4.conf.${iface}.arp_ignore" 2>/dev/null || echo '?')"
        aa="$(sysctl -n "net.ipv4.conf.${iface}.arp_announce" 2>/dev/null || echo '?')"
        printf '%-8s %-14s %-18s %-18s %-10s %-12s\n' "$iface" "${parent:-?}" "$mac" "${addr:---}" "$ai" "$aa"
    done < <(ip -o link show type macvlan 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep '^cl[0-9]' | sort -V || true)
    ;;
clients-delete)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    while read -r x; do [[ -n "$x" ]] && sudo_if_needed ip link del "$x" || true; done < <(ip -o link show type macvlan 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep '^cl[0-9]' || true)
    rm -f "$CLIENT_INTENT_DIR"/cl*-cl*.conf 2>/dev/null || true
    ;;
clients-arp)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; count=0
    while read -r iface; do
        [[ -n "$iface" ]] || continue
        ipaddr="$(ip -4 -o addr show dev "$iface" | awk '{print $4}' | cut -d/ -f1 | head -1)"
        [[ -n "$ipaddr" ]] || continue
        printf '%-8s %-15s ' "$iface" "$ipaddr"
        if sudo_if_needed arping -A -c 1 -I "$iface" "$ipaddr" >/dev/null 2>&1; then echo "ARP sent"; count=$((count + 1)); else echo "FAILED"; fi
    done < <(ip -o link show type macvlan 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep '^cl[0-9]' | sort -V || true)
    echo; echo "$count gratuitous ARPs sent."
    ;;
clients-ping)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 1 "$@"
    dst="$1"; ping_count="${2:-1}"
    while read -r iface; do
        [[ -n "$iface" ]] || continue
        ipaddr="$(ip -4 -o addr show dev "$iface" | awk '{print $4}' | cut -d/ -f1 | head -1)"
        [[ -n "$ipaddr" ]] || continue
        printf '%-8s %-15s -> %-15s ' "$iface" "$ipaddr" "$dst"
        if ping -I "$iface" -c "$ping_count" -W 1 "$dst" >/dev/null 2>&1; then echo OK; else echo 'NO REPLY'; fi
    done < <(ip -o link show type macvlan 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep '^cl[0-9]' | sort -V || true)
    ;;
clients-traffic)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"
    dst="$1"; port="$2"; interval="${3:-1}"
    while true; do
        while read -r iface; do
            [[ -n "$iface" ]] || continue
            ipaddr="$(ip -4 -o addr show dev "$iface" | awk '{print $4}' | cut -d/ -f1 | head -1)"
            [[ -n "$ipaddr" ]] || continue
            printf 'client=%s ip=%s time=%s\n' "$iface" "$ipaddr" "$(date +%s)" | socat - "UDP-DATAGRAM:${dst}:${port},bind=${ipaddr}" >/dev/null 2>&1 || true
        done < <(ip -o link show type macvlan 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep '^cl[0-9]' | sort -V || true)
        sleep "$interval"
    done
    ;;
endpoint-move) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 4 "$@"; old="$1"; new="$2"; addr="$3"; mac="$4"; sudo_if_needed ip addr del "$addr" dev "$old" 2>/dev/null || true; sudo_if_needed ip link set "$old" down; sudo_if_needed ip link set "$new" down; sudo_if_needed ip link set "$new" address "$mac"; sudo_if_needed ip addr replace "$addr" dev "$new"; sudo_if_needed ip link set "$new" up; sudo_if_needed arping -A -I "$new" -c 3 "${addr%/*}" || true ;;
send-tcp)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"
    dest="$1"; port="$2"; shift 2; msg=""; count=1; interval=0; source_ip=""
    if [[ $# -gt 0 && "$1" != --* ]]; then msg="$1"; shift; fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
          --count) count="${2:?--count requires a value}"; shift 2 ;;
          --interval) interval="${2:?--interval requires a value}"; shift 2 ;;
          --source) source_ip="${2:?--source requires a value}"; shift 2 ;;
          *) die "Unknown option: $1" ;;
        esac
    done
    if [[ -z "$msg" && ! -t 0 ]]; then msg="$(cat)"; fi
    [[ -n "$msg" ]] || msg="labhost-test"
    for ((n=1;n<=count;n++)); do
        if [[ -n "$source_ip" ]]; then
            printf '%s\n' "$msg" | socat - "TCP:$dest:$port,bind=$source_ip"
        else
            printf '%s\n' "$msg" | nc -w3 "$dest" "$port"
        fi
        if (( n < count )); then
            sleep "$interval"
        fi
    done
    ;;
send-udp) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; printf '%s\n' "${3:-labhost-test}" | nc -u -w1 "$1" "$2" ;;
send-broadcast) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 2 "$@"; i="$1"; p="$2"; msg="${3:-labhost-broadcast}"; bcast="$(ip -4 -o addr show dev "$i" | awk '{print $6}' | head -1)"; [[ -n "$bcast" ]] || die "No broadcast address on $i"; printf '%s\n' "$msg" | socat - UDP-DATAGRAM:"$bcast:$p",broadcast ;;
send-mcast) want_help "${1:-}" && { help_command "$CMD"; exit 0; }; require_args "$CMD" 3 "$@"; i="$1"; g="$2"; p="$3"; msg="${4:-labhost-multicast}"; src="$(ip -4 -o addr show dev "$i" scope global | awk '{print $4}' | cut -d/ -f1 | head -1)"; [[ -n "$src" ]] || die "No IPv4 address on $i"; printf '%s\n' "$msg" | socat - UDP-DATAGRAM:"$g:$p",ip-multicast-if="$src",ip-multicast-ttl=32 ;;
lab-save)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }
    dry=false; [[ "${1:-}" == "--dry-run" ]] && dry=true
    [[ $# -gt 0 && "${1:-}" != "--dry-run" ]] && { help_command "$CMD"; exit 2; }
    generated="$(mktemp)"; trap 'rm -f "$generated"' EXIT; generate_startup >"$generated"
    if $dry; then cat "$generated"; exit 0; fi
    [[ -d "$CONFIG_DIR" ]] || die "$CONFIG_DIR is not mounted. Add './configs:/config' to the Containerlab node."
    target="$(startup_path)"; [[ -f "$target" ]] && cp -a "$target" "${target}.bak"
    cp "$generated" "$target"; chmod 0755 "$target"
    echo "Saved startup configuration: $target"

    if [[ -f "${target}.bak" ]]; then
        echo "Previous configuration backup: ${target}.bak"
    fi

;;
lab-config)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }; action="${1:-show}"; f="$(startup_path)"
    case "$action" in
      show) [[ -f "$f" ]] || die "No startup configuration exists at $f"; cat "$f" ;;
      path) echo "$f" ;;
      edit) [[ -e "$f" ]] || { [[ -d "$CONFIG_DIR" ]] || die "$CONFIG_DIR is not mounted."; touch "$f"; chmod 0755 "$f"; }; editor="${EDITOR:-}"; [[ -n "$editor" ]] || { command -v nano >/dev/null && editor=nano || editor=vi; }; exec "$editor" "$f" ;;
      *) help_command "$CMD"; exit 2 ;;
    esac
    ;;
lab-reset)
    want_help "${1:-}" && { help_command "$CMD"; exit 0; }

    echo 'Removing PC/phone objects...'
    if [[ -d "$PC_PHONE_INTENT_DIR" ]]; then
        while read -r f; do
            [[ -n "$f" ]] || continue
            parent="$(basename "$f" .conf)"
            /usr/local/bin/pc-phone-delete "$parent" >/dev/null 2>&1 || true
        done < <(find "$PC_PHONE_INTENT_DIR" -maxdepth 1 -type f -name '*.conf' -print 2>/dev/null | sort)
    fi
    # Also remove orphaned runtime phone state if an intent file was lost.
    if [[ -d "$PC_PHONE_RUN_DIR" ]]; then
        while read -r f; do
            [[ -n "$f" ]] || continue
            parent="$(basename "$f" .origmac)"
            /usr/local/bin/pc-phone-delete "$parent" >/dev/null 2>&1 || true
        done < <(find "$PC_PHONE_RUN_DIR" -maxdepth 1 -type f -name '*.origmac' -print 2>/dev/null | sort)
    fi
    rm -rf "$PC_PHONE_RUN_DIR" 2>/dev/null || true
    rm -f "$PC_PHONE_INTENT_DIR"/*.conf 2>/dev/null || true

    echo 'Stopping DHCP services and clients...'
    dhcp_server_stop_impl || true
    sudo_if_needed pkill -x dhcpcd 2>/dev/null || true
    rm -f "$DHCP_INTENT_DIR"/* 2>/dev/null || true
    rm -f "$DHCP_SERVER_INTENT_DIR"/*.conf "$DHCP_SERVER_INTENT_DIR/.enabled" 2>/dev/null || true
    sudo_if_needed rm -rf "$DHCP_SERVER_RUN_DIR" 2>/dev/null || true

    echo 'Removing test qdiscs...'
    while read -r i; do
        [[ "$i" == "$MGMT_IF" || "$i" == "$MGMT_VRF" || "$i" == lo ]] && continue
        sudo_if_needed tc qdisc del dev "$i" root 2>/dev/null || true
    done < <(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1)

    echo 'Removing macvlan clients...'
    clients-delete || true

    echo 'Removing VLAN/QinQ interfaces...'
    while read -r v; do
        [[ -n "$v" ]] && sudo_if_needed ip link del "$v" 2>/dev/null || true
    done < <(ip -d -o link show type vlan 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | tac)

    echo 'Removing bonds...'
    if compgen -G '/proc/net/bonding/*' >/dev/null; then
        for f in /proc/net/bonding/*; do sudo_if_needed ip link del "${f##*/}" 2>/dev/null || true; done
    fi

    echo 'Removing user-created VRFs...'
    while read -r v; do
        [[ "$v" == "$MGMT_VRF" ]] && continue
        [[ -n "$v" ]] && sudo_if_needed ip link del "$v" 2>/dev/null || true
    done < <(ip -o link show type vrf 2>/dev/null | awk -F': ' '{print $2}' | awk '{print $1}' | cut -d@ -f1)

    sudo_if_needed ip link del br-wan 2>/dev/null || true
    sudo_if_needed pkill -f 'python3 -m http.server|in.tftpd|socat.*LISTEN|iperf3 -s|iperf -s' 2>/dev/null || true

    echo 'Flushing dataplane addresses and routes...'
    while read -r i; do
        [[ -n "$i" ]] || continue
        [[ "$i" == "$MGMT_IF" || "$i" == "$MGMT_VRF" || "$i" == lo ]] && continue
        [[ "$i" =~ ^eth[1-9][0-9]*$ ]] || continue
        sudo_if_needed ip -4 addr flush dev "$i" scope global 2>/dev/null || true
        sudo_if_needed ip -6 addr flush dev "$i" scope global 2>/dev/null || true
        sudo_if_needed ip -4 route flush dev "$i" 2>/dev/null || true
        sudo_if_needed ip -6 route flush dev "$i" 2>/dev/null || true
    done < <(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1)

    echo 'Restoring default dataplane MTU...'
    while read -r i; do
        [[ -n "$i" ]] || continue
        [[ "$i" =~ ^eth[1-9][0-9]*$ ]] || continue
        sudo_if_needed ip link set dev "$i" mtu "$DEFAULT_DATA_MTU" 2>/dev/null || true
    done < <(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1)
    rm -f "$MTU_ALL_INTENT" 2>/dev/null || true

    echo 'Reset complete; Containerlab management VRF/path and saved startup script were preserved.'

    ;;
*) echo "Unknown helper: $CMD"; usage; exit 2 ;;
esac
