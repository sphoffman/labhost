#!/bin/bash
set -euo pipefail

CORE=/usr/local/lib/labhost/labctl
INTENT_ROOT="${LABHOST_INTENT_DIR:-/run/labhost/intents}"
SERVICE_INTENT_DIR="$INTENT_ROOT/services"
STARTUP="/config/$(hostname -s).sh"

normalize_startup(){
    # Synthetic clients are recreated from clients-create intent, but the core
    # saver emits generic MTU state before that intent. Defer clN MTU commands
    # until the end of the base startup so replay never references a synthetic
    # interface before it exists. This also preserves deliberate non-1500 MTU
    # overrides instead of simply dropping synthetic-client MTU state.
    awk '
        /^mtu-set cl[0-9]+ [0-9]+$/ {
            deferred[++count] = $0
            next
        }
        { print }
        END {
            if (count > 0) {
                print ""
                print "# Synthetic client MTU state (after clients-create)"
                for (i = 1; i <= count; i++) print deferred[i]
            }
        }
    '
}

emit_services(){
    local f found=0
    [[ -d "$SERVICE_INTENT_DIR" ]] || return 0

    emit_file(){
        local intent_file="$1"
        [[ -r "$intent_file" ]] || return 0
        if (( found == 0 )); then
            echo
            echo '# LabHost v1.5 lightweight services'
            echo '# Reconstructed from working service intent at lab-save time.'
            found=1
        fi
        cat "$intent_file"
    }

    # Preserve deterministic lexical ordering for normal service intent, but
    # always defer the RADIUS server start until every persisted RADIUS client,
    # user, and future policy/config intent has been reconstructed. Starting
    # FreeRADIUS earlier would snapshot an incomplete runtime configuration.
    while IFS= read -r f; do
        emit_file "$f"
    done < <(
        find "$SERVICE_INTENT_DIR" -maxdepth 1 -type f -name '*.conf' \
            ! -name 'radius-server.conf' -print 2>/dev/null | sort
    )

    emit_file "$SERVICE_INTENT_DIR/radius-server.conf"
}

build_startup(){
    "$CORE" lab-save --dry-run | normalize_startup
    emit_services
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    exec "$CORE" lab-save --help
fi

if [[ "${1:-}" == "--dry-run" ]]; then
    [[ $# -eq 1 ]] || { echo 'Usage: lab-save [--dry-run]' >&2; exit 2; }
    build_startup
    exit 0
fi

[[ $# -eq 0 ]] || { echo 'Usage: lab-save [--dry-run]' >&2; exit 2; }
[[ -d /config ]] || { echo "ERROR: /config is not mounted. Add './configs:/config' to the Containerlab node." >&2; exit 1; }

# Generate the complete startup file as the invoking user, then use controlled
# self-elevation only for the bind-mounted write. This deliberately avoids any
# requirement for a matching host-side `lab` account or UID and works when the
# host repository/config directory is root-owned.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
build_startup >"$tmp"

if [[ -f "$STARTUP" ]]; then
    sudo install -o root -g root -m 0755 "$STARTUP" "${STARTUP}.bak"
fi

sudo install -o root -g root -m 0755 "$tmp" "$STARTUP"

echo "Saved startup configuration: $STARTUP"
if [[ -f "${STARTUP}.bak" ]]; then
    echo "Previous configuration backup: ${STARTUP}.bak"
fi
