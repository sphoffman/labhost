#!/bin/bash
set -euo pipefail

CORE=/usr/local/lib/labhost/labctl
INTENT_ROOT="${LABHOST_INTENT_DIR:-/run/labhost/intents}"
SERVICE_INTENT_DIR="$INTENT_ROOT/services"
STARTUP="/config/$(hostname -s).sh"

emit_services(){
    local f found=0
    [[ -d "$SERVICE_INTENT_DIR" ]] || return 0
    while IFS= read -r f; do
        [[ -r "$f" ]] || continue
        if (( found == 0 )); then
            echo
            echo '# LabHost v1.5 lightweight services'
            echo '# Reconstructed from working service intent at lab-save time.'
            found=1
        fi
        cat "$f"
    done < <(find "$SERVICE_INTENT_DIR" -maxdepth 1 -type f -name '*.conf' -print 2>/dev/null | sort)
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    exec "$CORE" lab-save --help
fi

if [[ "${1:-}" == "--dry-run" ]]; then
    [[ $# -eq 1 ]] || { echo 'Usage: lab-save [--dry-run]' >&2; exit 2; }
    "$CORE" lab-save --dry-run
    emit_services
    exit 0
fi

[[ $# -eq 0 ]] || { echo 'Usage: lab-save [--dry-run]' >&2; exit 2; }

# Let the proven v1.4 implementation generate and safely write the base startup
# file first, including its backup/root-owned bind-mount handling.
"$CORE" lab-save

if compgen -G "$SERVICE_INTENT_DIR/*.conf" >/dev/null; then
    tmp="$(mktemp)"
    emit_services >"$tmp"
    sudo tee -a "$STARTUP" <"$tmp" >/dev/null
    rm -f "$tmp"
    sudo chown root:root "$STARTUP"
    sudo chmod 0755 "$STARTUP"
    echo "Appended LabHost v1.5 service intent to $STARTUP"
fi
