#!/bin/bash
set -euo pipefail

cmd="$(basename "$0")"
core=/usr/local/lib/labhost/labctl

# Keep exactly one authoritative reset implementation.  The public lab-reset
# command is the hardened, regression-tested path; make `labctl lab-reset`
# converge on that same implementation rather than the legacy case statement
# still present in the monolithic core.
if [[ "$cmd" == "labctl" && "${1:-}" == "lab-reset" ]]; then
    shift
    exec /usr/local/bin/lab-reset "$@"
fi

# Friendly commands such as ip-set are symlinks to this dispatcher.  Feed the
# invoked command name to the core as labctl's first argument so the existing
# command dispatch semantics remain unchanged.
if [[ "$cmd" == "labctl" ]]; then
    exec "$core" "$@"
else
    exec "$core" "$cmd" "$@"
fi
