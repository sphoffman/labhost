#!/bin/bash
set -euo pipefail

dst="${1:?Usage: clients-traffic <destination> <port> [interval]}"
port="${2:?Usage: clients-traffic <destination> <port> [interval]}"
interval="${3:-1}"

while true; do
    for iface in $(ip -o link show type macvlan | awk -F': ' '{print $2}' | cut -d@ -f1 | grep '^cl[0-9]' | sort); do
        ipaddr="$(
            ip -4 -o addr show dev "$iface" |
            awk '{print $4}' |
            cut -d/ -f1 |
            head -1
        )"

        [[ -n "$ipaddr" ]] || continue

        printf 'client=%s ip=%s time=%s\n' \
            "$iface" \
            "$ipaddr" \
            "$(date +%s)" |
        socat - \
            "UDP-DATAGRAM:${dst}:${port},bind=${ipaddr}" \
            >/dev/null 2>&1 || true
    done

    sleep "$interval"
done
